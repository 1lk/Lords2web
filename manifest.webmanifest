{
  "name": "Lords of the Realm II (demo) — Web Port",
  "short_name": "Lords II",
  "description": "Native WebAssembly port of the Lords of the Realm II demo with touch controls. Bring your own lorddemo.exe.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#130e08",
  "theme_color": "#130e08",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
